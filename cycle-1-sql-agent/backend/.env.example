# Backend Environment Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
MAX_ITERATIONS=5

# LLM Providers (Pick one or leave blank for internal intelligent fallback engine)
# Supported options: "gemini", "openai", "groq", "ollama", "auto"
LLM_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama Local (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# SQLite Database
DATABASE_PATH=data/university.db
LOG_FILE_PATH=logs/agent.log
